<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access — required to load sign URLs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Boot receiver — required for auto-start on device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network state — used to check connectivity before loading content -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        INTERACT_ACROSS_USERS permissions are required for Aggressive Restart
        to work correctly on Fire OS. Both the standard and Amazon-specific
        variants must be declared. DO NOT REMOVE the amazon.aosp variant.
    -->
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS_FULL"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="amazon.aosp.permission.INTERACT_ACROSS_USERS_FULL" />

    <!--
        Firestick has no touchscreen — declaring required="false" prevents the
        app from being filtered as incompatible on TV-only hardware.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Declare leanback (TV UI) capability without requiring it,
        so the app works on both Fire TV and standard Android devices.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:launchMode="singleInstance"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebSignDisplayV2"
        android:usesCleartextTraffic="true"
        tools:targetApi="28">

        <!-- Main fullscreen display activity -->
        <activity
            android:name=".FullscreenActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:theme="@style/Theme.WebSignDisplayV2.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER: shows app in standard Android launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                    LEANBACK_LAUNCHER: required for the app to appear in the
                    Fire TV home screen Apps row. Without this, sideloaded apps
                    are only accessible via Settings > Applications, not the home screen.
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings / configuration screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.WebSignDisplayV2.Settings"
            android:label="@string/title_activity_settings" />

        <!--
            Boot receiver — launches app on device startup if Auto Start is enabled.
            Note: android:permission is intentionally absent here. Setting it on a
            <receiver> restricts senders, not receivers — the system boot broadcast
            does not carry that permission and the event would be silently dropped.
        -->
        <receiver
            android:name=".BootUpReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
