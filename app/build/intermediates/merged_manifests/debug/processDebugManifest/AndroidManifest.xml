<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mattlabs.websigndisplay"
    android:versionCode="2"
    android:versionName="2.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="36" />

    <!-- Internet access — required to load sign URLs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Boot receiver — required for auto-start on device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network state — used to check connectivity before loading content -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        INTERACT_ACROSS_USERS permissions are required for Aggressive Restart
        to work correctly on Fire OS. Both the standard and Amazon-specific
        variants must be declared. DO NOT REMOVE the amazon.aosp variant.
    -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="amazon.aosp.permission.INTERACT_ACROSS_USERS_FULL" />

    <!--
        Firestick has no touchscreen — declaring required="false" prevents the
        app from being filtered as incompatible on TV-only hardware.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Declare leanback (TV UI) capability without requiring it,
        so the app works on both Fire TV and standard Android devices.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <permission
        android:name="com.mattlabs.websigndisplay.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.mattlabs.websigndisplay.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:launchMode="singleInstance"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.WebSignDisplayV2"
        android:usesCleartextTraffic="true" >

        <!-- Main fullscreen display activity -->
        <activity
            android:name="com.mattlabs.websigndisplay.FullscreenActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:theme="@style/Theme.WebSignDisplayV2.Fullscreen" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER: shows app in standard Android launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                    LEANBACK_LAUNCHER: required for the app to appear in the
                    Fire TV home screen Apps row. Without this, sideloaded apps
                    are only accessible via Settings > Applications, not the home screen.
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings / configuration screen -->
        <activity
            android:name="com.mattlabs.websigndisplay.SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.WebSignDisplayV2.Settings" />

        <!--
            Boot receiver — launches app on device startup if Auto Start is enabled.
            Note: android:permission is intentionally absent here. Setting it on a
            <receiver> restricts senders, not receivers — the system boot broadcast
            does not carry that permission and the event would be silently dropped.
        -->
        <receiver
            android:name="com.mattlabs.websigndisplay.BootUpReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.mattlabs.websigndisplay.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>